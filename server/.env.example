# 飞书开放平台应用凭证：https://open.feishu.cn/app
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
# 可选：正文由主应用读取、图片/附件由具备 drive:media:download 且有文档访问权的应用下载。
# 同时填写两项才会启用；未填写时图片下载仍使用主应用身份。
# FEISHU_MEDIA_APP_ID=cli_your_media_app_id
# FEISHU_MEDIA_APP_SECRET=your_media_app_secret
# 可选，默认 https://open.feishu.cn
# FEISHU_OPEN_API_BASE_URL=https://open.feishu.cn
